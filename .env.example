# Copy to .env.local. Never commit .env.local.
MSSQL_SERVER=127.0.0.1
MSSQL_DATABASE=BGIQuiz
MSSQL_USER=bgi_quiz_app
MSSQL_PASSWORD=
MSSQL_PORT=1433
# For a named instance, omit MSSQL_PORT and set MSSQL_INSTANCE instead.
# MSSQL_INSTANCE=SQLEXPRESS
MSSQL_ENCRYPT=true
MSSQL_TRUST_SERVER_CERTIFICATE=false
MSSQL_CONNECTION_TIMEOUT=15000
MSSQL_REQUEST_TIMEOUT=15000
MSSQL_POOL_MAX=10
# Set a long, unique organizer password for production Next.js.
BGI_ADMIN_TOKEN=
